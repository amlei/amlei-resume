{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amlei.dev/skills/amlei-profile/schemas/emphasis-projects.json",
  "title": "Emphasis — Projects (per identity)",
  "description": "某身份下对 projects 的选材 + framing。bullet 是用户/agent 重写的产物，可自由区别于 fact 层的 granularity text。excluded 显式记录未选原因。",
  "type": "object",
  "additionalProperties": false,
  "required": ["_meta", "selected"],
  "properties": {
    "_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts_version_at_last_sync", "needs_review"],
      "properties": {
        "facts_version_at_last_sync": {
          "type": "string",
          "format": "date-time",
          "description": "上次同步时的事实层版本；当前 _shared/_meta.facts_version 比这新 → needs_review"
        },
        "needs_review": { "type": "boolean" }
      }
    },
    "selected": {
      "type": "array",
      "description": "选中 project id 列表，顺序 = 简历渲染顺序",
      "items": { "type": "string", "pattern": "^prj_[a-z0-9_]+$" }
    },
    "framing": {
      "type": "object",
      "description": "key = project id；每个 project 一条 framing",
      "patternProperties": {
        "^prj_[a-z0-9_]+$": { "$ref": "#/$defs/framing" }
      },
      "additionalProperties": false
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^prj_[a-z0-9_]+$" },
          "reason": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "framing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_grain_index", "bullet"],
      "properties": {
        "source_grain_index": {
          "type": "integer",
          "minimum": 0,
          "description": "引用 fact 层 granularity 数组的下标"
        },
        "bullet": {
          "type": "string",
          "minLength": 1,
          "description": "简历用的 bullet 文案，可自由重写（不自动同步自 fact 层）"
        },
        "skill_attribution": {
          "type": "array",
          "description": "归到的 capability id",
          "items": { "type": "string", "pattern": "^cap_[a-z0-9_]+$" }
        }
      }
    }
  }
}
