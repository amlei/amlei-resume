{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amlei.dev/skills/amlei-profile/schemas/target.json",
  "title": "Identity Target (per identity)",
  "description": "某身份的方向定义、求职偏好、目标公司。target.json 与 emphasis/ 同级，定义'我在追什么岗'。",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity_id", "direction"],
  "properties": {
    "identity_id": {
      "type": "string",
      "minLength": 1,
      "description": "与目录名一致（如 'backend-2024'）"
    },
    "direction": { "type": "string", "description": "方向名（如 '后端开发'）" },
    "target_role_tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "岗位核心 tag，用于投影打分"
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "city": { "type": "string", "description": "投递目标城市（强调层，与 identity.city_base 区分）" },
        "salary": { "type": "string" },
        "exp": { "type": "string" },
        "degree": { "type": "string" },
        "scale": { "type": "string", "description": "公司规模偏好" },
        "industry": { "type": "string" }
      }
    },
    "target_companies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["company"],
        "properties": {
          "company": { "type": "string" },
          "position": { "type": "string" },
          "industry": { "type": "string" },
          "jd": { "type": "string" },
          "url": { "type": "string" },
          "jd_ref": { "type": "string", "description": "指向 resumes/{app}/jd.md" }
        }
      }
    },
    "created_from_projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projected_at": { "type": "string", "format": "date-time" },
        "jd_basis": { "type": "string", "description": "投影所基于的 JD / 方向描述" }
      }
    }
  }
}
